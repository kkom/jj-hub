{
  "name": "jj-octo",
  "version": "0.2.4",
  "description": "A jj subcommand for working with GitHub that supports stacking",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkom/jj-octo.git"
  },
  "bin": {
    "jj-octo": "dist/jj-octo.js"
  },
  "files": [
    "dist/jj-octo.js"
  ],
  "type": "module",
  "scripts": {
    "build": "bun build src/main.ts --target=bun --outfile dist/jj-octo.js && chmod +x dist/jj-octo.js",
    "check": "bun run --sequential \"check:*\" && bun run test && bun run build",
    "check:format": "oxfmt --check .",
    "check:lint": "oxlint .",
    "check:types": "tsc",
    "fix": "bun run --sequential \"fix:*\"",
    "fix:format": "oxfmt .",
    "fix:lint": "oxlint --fix .",
    "prepack": "bun run build",
    "release:major": "bun pm version major --no-git-tag-version",
    "release:minor": "bun pm version minor --no-git-tag-version",
    "release:patch": "bun pm version patch --no-git-tag-version",
    "test": "bun test ./src"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.1",
    "@octokit/openapi-types": "29.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.2",
    "effect": "4.0.1",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.2"
}
