{
  "extends": "@tsconfig/strictest/tsconfig.json",
  "compilerOptions": {
    "module": "Preserve",
    "lib": ["ESNext"],
    "types": ["@types/bun"],
    "erasableSyntaxOnly": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": ["scripts", "src"]
}
